{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "missing": [{ "type": "query", "key": "widget" }],
      "destination": "/en?",
      "permanent": true
    },
    {
      "source": "/height-compare",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/en/height-compare?",
      "permanent": true
    }
  ]
}
